generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password      String
  role          Role     @default(USER)
  phoneNumber   String
  institution   String
  yearOfBirth   Int
  gender        String
  hilals        Hilal[]
}

model Hilal {
  id          Int      @id @default(autoincrement())
  url         String   // temporary
  images      Photo[]  @ignore
  ownerId     Int
  owner       User     @relation(fields: [ownerId], references: [id])
  description String
  status      Status   @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Photo {
  id        Int      @id @default(autoincrement())
  url       String
  type      Type
  hilalId   Int
  hilal     Hilal    @relation(fields: [hilalId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@ignore
}

enum Role {
  USER
  ADMIN
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

enum Type {
  CAMERA
  TELESCOPE
}
